# Google OAuth2
# Register your app at https://console.cloud.google.com
# Add http://localhost:8585/api/v1/auth/gmail/callback as an authorised redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth2 (Outlook / Exchange)
# Register your app at https://portal.azure.com → App registrations
# Add http://localhost:8585/api/v1/auth/microsoft/callback as a redirect URI
# Required API permissions: Mail.ReadWrite, Mail.Send, offline_access
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Application login. Set a 12+ character password before first startup. On an
# empty database this creates the single application user. Use a secret manager
# in production and remove the password variable after successful bootstrap.
# An empty value is ignored.
EMAIL_RS_BOOTSTRAP_USERNAME=admin
EMAIL_RS_BOOTSTRAP_PASSWORD=

# Required for non-loopback production deployments. Caddy should terminate TLS
# and forward requests to the server over the private container network.
# EMAIL_RS_PUBLIC_URL=https://mail.example.com
# Optional comma-separated mobile/development origins that may read CORS responses.
# EMAIL_RS_ALLOWED_ORIGINS=capacitor://localhost,http://localhost:5173

# Attachment safety limits. Content larger than the cache limit is fetched on
# demand; content larger than the download limit is rejected with HTTP 413.
# ATTACHMENT_CACHE_MAX_BYTES=26214400
# ATTACHMENT_DOWNLOAD_MAX_BYTES=52428800
# ATTACHMENT_PROVIDER_TIMEOUT_SECS=30

# Set automatically by docker-compose — override only if needed
# GOOGLE_REDIRECT_URI=http://localhost:8585/api/v1/auth/gmail/callback
# MICROSOFT_REDIRECT_URI=http://localhost:8585/api/v1/auth/microsoft/callback
# DATABASE_URL=sqlite:///data/email.db
